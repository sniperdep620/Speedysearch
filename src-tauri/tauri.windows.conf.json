{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "npm run dev:windows",
    "beforeBuildCommand": "npm run build:windows"
  },
  "bundle": {
    "targets": ["nsis"],
    "resources": {
      "../windows-native/bin/Release/speedysearch-cli.exe": "speedysearch-cli.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
