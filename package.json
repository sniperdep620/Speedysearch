{
  "name": "speedysearch-ui",
  "private": true,
  "version": "0.2.0",
  "description": "Fast, private local search for Linux desktops",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "setup": "bash ./setup.sh",
    "check": "bash ./scripts/check.sh",
    "dev": "vite --config frontend/vite.config.ts",
    "build": "tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "test": "npm run test:unit && npm run test:identity",
    "test:unit": "vitest run --config frontend/vite.config.ts",
    "test:identity": "bash tests/application_identity_test.sh",
    "test:watch": "vitest --config frontend/vite.config.ts",
    "test:e2e": "playwright test -c frontend/playwright.config.ts",
    "install:user": "./scripts/install-user.sh",
    "uninstall:user": "./scripts/uninstall-user.sh",
    "system-search:enable": "./scripts/system-search.sh enable",
    "system-search:restore": "./scripts/system-search.sh restore",
    "system-search:status": "./scripts/system-search.sh status",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
